{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for professionals (psychologists, therapists, psychoanalysts, pastors) and patients on Psiconnect",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["patient", "psychologist", "therapist", "psychoanalyst", "pastor", "professional"] },
        "professionalType": { "type": "string", "enum": ["psychologist", "therapist", "psychoanalyst", "pastor"] },
        "careCategory": { "type": "string", "enum": ["therapy", "biblical"] },
        "phone": { "type": "string", "maxLength": 30 },
        "crp": { "type": "string", "maxLength": 50 },
        "registrationNumber": { "type": "string", "maxLength": 50 },
        "ministryOrChurch": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "hourlyRate": { "type": "number" },
        "sessionDuration": { "type": "number" },
        "avatar": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "defaultMeetingType": { "type": "string", "enum": ["native", "external"] },
        "externalMeetingUrl": { "type": "string", "maxLength": 500 },
        "clinicalTags": { "type": "array", "description": "Clinical experience tags selected by the professional for matching" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "joinedAt"]
    },
    "AvailabilitySlot": {
      "title": "AvailabilitySlot",
      "description": "Availability slot for a professional, supports periods and social care",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "psychologistId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dayOfWeek": { "type": "number" },
        "startTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "endTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "isSocial": { "type": "boolean" },
        "socialRate": { "type": "number" }
      },
      "required": ["id", "psychologistId", "dayOfWeek", "startTime", "endTime", "isActive"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Telehealth appointment booking between patient and professional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "psychologistId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "psychologistName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "psychologistAvatar": { "type": "string", "maxLength": 500 },
        "psychologistCrp": { "type": "string", "maxLength": 50 },
        "professionalType": { "type": "string", "enum": ["psychologist", "therapist", "psychoanalyst", "pastor"] },
        "careCategory": { "type": "string", "enum": ["therapy", "biblical"] },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "patientEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "patientPhone": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10 },
        "time": { "type": "string", "minLength": 4, "maxLength": 10 },
        "endTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "meetingType": { "type": "string", "enum": ["native", "external"] },
        "meetingUrl": { "type": "string", "maxLength": 500 },
        "notesFromPatient": { "type": "string", "maxLength": 1000 },
        "isSocial": { "type": "boolean" },
        "socialRate": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "psychologistId", "psychologistName", "patientId", "patientName", "patientEmail", "date", "time", "endTime", "status", "meetingType", "createdAt"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Confidential electronic patient health or pastoral counseling record managed by the professional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "appointmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "psychologistId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "professionalType": { "type": "string", "enum": ["psychologist", "therapist", "psychoanalyst", "pastor"] },
        "careCategory": { "type": "string", "enum": ["therapy", "biblical"] },
        "sessionDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "chiefComplaint": { "type": "string", "maxLength": 2000 },
        "clinicalEvolution": { "type": "string", "maxLength": 4000 },
        "privateNotes": { "type": "string", "maxLength": 4000 },
        "recommendations": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "appointmentId", "patientId", "patientName", "psychologistId", "sessionDate", "chiefComplaint", "clinicalEvolution", "privateNotes", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live session text message between patient and professional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "appointmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["patient", "psychologist", "therapist", "psychoanalyst", "pastor", "professional"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "appointmentId", "senderId", "senderName", "senderRole", "text", "timestamp"]
    },
    "PsychologicalRecord": {
      "title": "PsychologicalRecord",
      "description": "Complete psychological clinical record with patient identification, demand, history, therapeutic plan, evolution sessions, and audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "professionalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "paused", "discharged", "abandoned", "referred"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "professionalId", "status", "createdAt", "updatedAt"]
    },
    "ClinicalForm": {
      "title": "ClinicalForm",
      "description": "Custom psychological research and clinical monitoring questionnaires created by professionals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "professionalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "professionalName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["anxiety", "mood", "followup", "burnout", "anamnesis", "general"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "isAnonymous": { "type": "boolean" },
        "allowMultipleSubmissions": { "type": "boolean" },
        "periodicity": { "type": "string", "enum": ["weekly", "biweekly", "monthly", "on_demand"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "professionalId", "title", "status", "createdAt", "updatedAt"]
    },
    "FormDispatch": {
      "title": "FormDispatch",
      "description": "Individual dispatch records sent by professionals to specific patients with timestamps and deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "formId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "formTitle": { "type": "string", "maxLength": 150 },
        "professionalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 100 },
        "patientEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "sentAt": { "type": "string" },
        "deadline": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "completed", "expired"] },
        "submissionCount": { "type": "number" },
        "lastSubmittedAt": { "type": "string" },
        "shareToken": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "formId", "professionalId", "patientId", "sentAt", "status", "shareToken"]
    },
    "FormSubmission": {
      "title": "FormSubmission",
      "description": "Patient survey and clinical monitoring responses with encrypted clinical answers and submission timestamps",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "formId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "formTitle": { "type": "string", "maxLength": 150 },
        "dispatchId": { "type": "string", "maxLength": 128 },
        "professionalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 100 },
        "patientEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "submittedAt": { "type": "string" },
        "encryptedPayload": { "type": "string" },
        "isReadByProfessional": { "type": "boolean" },
        "readAt": { "type": "string" }
      },
      "required": ["id", "formId", "professionalId", "patientId", "submittedAt", "isReadByProfessional"]
    },
    "ClinicUnit": {
      "title": "ClinicUnit",
      "description": "Physical clinical healthcare unit with regulatory credentials (CNPJ, CNES, RT CRP), contacts, media photos, address, accessibility, and service modalities",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cnpj": { "type": "string", "maxLength": 30 },
        "tradeName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "legalName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cnesNumber": { "type": "string", "maxLength": 20 },
        "technicalLeadName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "technicalLeadCrp": { "type": "string", "minLength": 1, "maxLength": 50 },
        "landlinePhone": { "type": "string", "maxLength": 30 },
        "receptionWhatsapp": { "type": "string", "maxLength": 30 },
        "institutionalEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "zipCode": { "type": "string", "maxLength": 20 },
        "street": { "type": "string", "maxLength": 150 },
        "number": { "type": "string", "maxLength": 20 },
        "complement": { "type": "string", "maxLength": 100 },
        "neighborhood": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "operatingHours": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "cnpj", "tradeName", "legalName", "technicalLeadName", "technicalLeadCrp", "zipCode", "street", "number", "city", "state", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for registered professionals and patients"
    },
    "/slots/{slotId}": {
      "schema": "AvailabilitySlot",
      "description": "Weekly calendar slots published by professionals"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Scheduled therapy and biblical counseling appointments"
    },
    "/medicalRecords/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Confidential medical record documents (PEP) and pastoral records managed by professionals"
    },
    "/psychologicalRecords/{recordId}": {
      "schema": "PsychologicalRecord",
      "description": "Electronic psychological medical records and evolution timelines"
    },
    "/clinicalForms/{formId}": {
      "schema": "ClinicalForm",
      "description": "Clinical research and evaluation forms configured by professionals"
    },
    "/formDispatches/{dispatchId}": {
      "schema": "FormDispatch",
      "description": "Form assignment and dispatch tracking records"
    },
    "/formSubmissions/{submissionId}": {
      "schema": "FormSubmission",
      "description": "Completed psychological questionnaires and encrypted response data"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time consultation chat messages"
    },
    "/clinicUnits/{unitId}": {
      "schema": "ClinicUnit",
      "description": "Registered clinic units and physical consultation facilities"
    }
  }
}

